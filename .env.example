# ── Frontend SGRC — variables de entorno (plantilla, copiar a .env) ──

# Modo de datos. Hay que pedir el modo demo de forma EXPLÍCITA:
#   true            = datos de demostración locales (mock-data.js), sin backend.
#                     La app pinta un distintivo rojo permanente mientras está activo.
#   false / ausente = habla con el backend Express real (producción). Es el defecto:
#                     si la variable falta en un despliegue, la app NO inventa datos.
VITE_DEMO_MODE=false

# URL base del backend (solo se usa cuando VITE_DEMO_MODE=false).
# - En local con el proxy de Vite, puedes dejarlo vacío o en "/api".
# - En producción (Vercel), apunta al dominio del backend, p.ej.:
#   VITE_API_BASE=https://sgrc-backend.up.railway.app/api
VITE_API_BASE=/api
