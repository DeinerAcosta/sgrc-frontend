# ── Frontend SGRC — variables de entorno (plantilla, copiar a .env) ──

# Modo de datos:
#   true  = usa datos de demostración locales (mock-data.js), sin backend
#   false = habla con el backend Express real (producción)
VITE_DEMO_MODE=false

# URL base del backend (solo se usa cuando VITE_DEMO_MODE=false).
# - En local con el proxy de Vite, puedes dejarlo vacío o en "/api".
# - En producción (Vercel), apunta al dominio del backend, p.ej.:
#   VITE_API_BASE=https://sgrc-backend.up.railway.app/api
VITE_API_BASE=/api
